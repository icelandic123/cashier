local TestKit = require("../TestKit")
local helpers = require("./helpers")
local describe, it, expect, flush = TestKit.describe, TestKit.it, TestKit.expect, TestKit.flush

describe("game passes", function()
	it("runs the handler on join for owners", function()
		local cashier, mock = helpers.setup()
		local ran = {}
		cashier:Pass(50, function(player)
			table.insert(ran, player.UserId)
		end)
		cashier:Start()
		mock:SetPassOwned(101, 50)
		mock:AddPlayer(101)
		mock:AddPlayer(102)
		flush()
		expect(#ran).toBe(1)
		expect(ran[1]).toBe(101)
	end)

	it("runs the handler when a pass is bought in game, once", function()
		local cashier, mock = helpers.setup()
		local count = 0
		cashier:Pass(50, function()
			count += 1
		end)
		cashier:Start()
		local player = mock:AddPlayer(101)
		flush()
		expect(cashier:OwnsPass(player, 50)).toBe(false)
		mock:BuyPass(player, 50)
		mock:BuyPass(player, 50)
		flush()
		expect(count).toBe(1)
		expect(cashier:OwnsPass(player, 50)).toBe(true)
	end)

	it("covers players who joined before Start", function()
		local cashier, mock = helpers.setup()
		local ran = false
		mock:SetPassOwned(101, 50)
		mock:AddPlayer(101)
		cashier:Pass(50, function()
			ran = true
		end)
		cashier:Start()
		flush()
		expect(ran).toBe(true)
	end)

	it("covers passes registered after Start", function()
		local cashier, mock = helpers.setup()
		cashier:Start()
		mock:SetPassOwned(101, 50)
		mock:AddPlayer(101)
		flush()
		local ran = false
		cashier:Pass(50, function()
			ran = true
		end)
		flush()
		expect(ran).toBe(true)
	end)

	it("retries when the ownership check fails", function()
		local cashier, mock, logs = helpers.setup({ retries = 1 })
		local ran = false
		cashier:Pass(50, function()
			ran = true
		end)
		cashier:Start()
		mock:SetPassOwned(101, 50)
		mock:FailNext("UserOwnsGamePassAsync", 3)
		mock:AddPlayer(101)
		flush(20)
		expect(ran).toBe(true)
		expect(helpers.hasLog(logs, "could not check pass 50")).toBe(true)
	end)

	it("returns nil from OwnsPass before the first check", function()
		local cashier, mock = helpers.setup()
		cashier:Pass(50, function() end)
		cashier:Start()
		local player = { UserId = 1 }
		expect(cashier:OwnsPass(player :: any, 50)).toBeNil()
		local real = mock:AddPlayer(101)
		flush()
		expect(cashier:OwnsPass(real, 50)).toBe(false)
	end)

	it("reapplies perCharacter passes on every spawn", function()
		local cashier, mock = helpers.setup()
		local calls = {}
		cashier:Pass(50, function(_, character)
			table.insert(calls, if character then "character" else "player")
		end, { perCharacter = true })
		cashier:Start()
		mock:SetPassOwned(101, 50)
		local player = mock:AddPlayer(101)
		flush()
		mock:SpawnCharacter(player)
		mock:SpawnCharacter(player)
		flush()
		expect(table.concat(calls, ",")).toBe("player,character,character")
	end)

	it("stops reapplying after the player leaves", function()
		local cashier, mock = helpers.setup()
		local calls = 0
		cashier:Pass(50, function()
			calls += 1
		end, { perCharacter = true })
		cashier:Start()
		mock:SetPassOwned(101, 50)
		local player = mock:AddPlayer(101)
		flush()
		mock:RemovePlayer(player)
		flush()
		mock:SpawnCharacter(player)
		flush()
		expect(calls).toBe(1)
	end)

	it("keeps going when a handler errors", function()
		local cashier, mock, logs = helpers.setup()
		cashier:Pass(50, function()
			error("bad handler")
		end)
		cashier:Start()
		mock:SetPassOwned(101, 50)
		local player = mock:AddPlayer(101)
		flush()
		expect(cashier:OwnsPass(player, 50)).toBe(true)
		expect(helpers.hasLog(logs, "bad handler")).toBe(true)
	end)
end)

return nil
